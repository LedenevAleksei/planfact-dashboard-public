# Скопируйте этот файл в .env и подставьте значения (локально, Фаза 1).
# На сервере (PaaS, Фаза 2) те же переменные задаются в панели сервиса, .env не нужен.
# cp .env.example .env

# Ключ ПланФакта (только чтение). В браузер/логи/коммиты не попадает.
PLANFACT_API_KEY=ваш_ключ_здесь

# Логин/пароль для входа в веб-дашборд (Фаза 2). Придумайте свои.
DASH_USER=admin
DASH_PASS=смените_этот_пароль

# Supabase — хранилище реестров одобрения платежей (Фаза 2).
# URL проекта и СЕРВИСНЫЙ ключ (service_role). Только на сервере, в браузер не уходят.
# Взять в Supabase → Project Settings → API. Если не заданы — реестры падают в localStorage.
SUPABASE_URL=https://ВАШ_ПРОЕКТ.supabase.co
SUPABASE_SERVICE_KEY=service_role_ключ_здесь

# Cloudflare Access (Вариант A: Railway за Cloudflare). Если заданы — вход на домене
# идёт через Cloudflare Access (без второго пароля), прямой Railway-URL остаётся под Basic-Auth.
# Взять в Cloudflare Zero Trust → Access → Applications (домен команды и Application Audience/AUD).
# CF_ACCESS_TEAM_DOMAIN=ваша-команда.cloudflareaccess.com
# CF_ACCESS_AUD=длинный_hex_из_настроек_Access-приложения

# Необязательно: часовой пояс и час автообновления (по умолчанию Europe/Belgrade, 10:00)
# DASH_TZ=Europe/Belgrade
# DASH_REFRESH_HOUR=10
